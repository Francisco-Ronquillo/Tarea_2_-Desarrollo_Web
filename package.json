{
  "name": "catalogo-api",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos con favoritos y acceso por roles (Express + PostgreSQL + JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/crearAdmin.js",
    "test:newman": "newman run postman/Catalogo.postman_collection.json -e postman/Catalogo.postman_environment.json"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "newman": "^6.2.1"
  }
}
